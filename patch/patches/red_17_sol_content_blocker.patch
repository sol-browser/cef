+#if BUILDFLAG(IS_WIN)
+// Sol: the built-in content blocker. Sol stages the official uBlock Origin
+// release, with the official public key added to its manifest, in
+// <exe dir>/extensions/ublock (Sol docs/ublock-origin.md). It is as trusted as
+// the engine binaries next to it.
+constexpr char kSolContentBlockerId[] = "fkgkibajhfbepljeaefdnfnegdcjomkh";
+constexpr char kSolDisableContentBlockerSwitch[] =
+    "sol-disable-content-blocker";
+
+// Sol's web profiles: <user data>/Default and <user data>/Profile-<uuid>, named
+// like Sol's BrowsingProfiles. Not Sol's own pages (Shell) and not an
+// off-the-record context.
+bool IsSolWebProfile(const Profile& profile) {
+  base::FilePath user_data;
+  if (profile.IsOffTheRecord() ||
+      !base::PathService::Get(chrome::DIR_USER_DATA, &user_data) ||
+      profile.GetPath().DirName() != user_data) {
+    return false;
+  }
+  const std::string name = profile.GetPath().BaseName().MaybeAsASCII();
+  if (name == "Default") {
+    return true;
+  }
+  constexpr std::string_view kPrefix = "Profile-";
+  if (!name.starts_with(kPrefix) || name.size() != kPrefix.size() + 36) {
+    return false;
+  }
+  const std::string_view id = std::string_view(name).substr(kPrefix.size());
+  for (size_t i = 0; i < id.size(); ++i) {
+    const bool dash = i == 8 || i == 13 || i == 18 || i == 23;
+    if (dash ? id[i] != '-'
+             : !(base::IsAsciiDigit(id[i]) || (id[i] >= 'a' && id[i] <= 'f'))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::optional<base::DictValue> LoadSolContentBlockerManifest(
+    const base::FilePath& root_directory) {
+  std::string error;
+  std::optional<base::DictValue> manifest =
+      file_util::LoadManifest(root_directory, &error);
+  if (manifest && TryGenerateId(*manifest) != kSolContentBlockerId) {
+    error = "the manifest key does not give the expected extension ID";
+    manifest.reset();
+  }
+  if (manifest &&
+      !extension_l10n_util::LocalizeExtension(
+          root_directory, &*manifest,
+          extension_l10n_util::GzippedMessagesPermission::kDisallow, &error)) {
+    manifest.reset();
+  }
+  if (!manifest) {
+    LOG(ERROR) << "Sol content blocker not loaded from "
+               << root_directory.AsUTF8Unsafe() << ": " << error;
+  }
+  return manifest;
+}
+#endif  // BUILDFLAG(IS_WIN)
+
 }  // namespace
 
