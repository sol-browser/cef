+#if BUILDFLAG(IS_WIN)
+void ComponentLoader::AddSolContentBlocker() {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          kSolDisableContentBlockerSwitch) ||
+      !IsSolWebProfile(*profile_)) {
+    return;
+  }
+  base::FilePath root_directory;
+  if (!base::PathService::Get(base::DIR_EXE, &root_directory)) {
+    return;
+  }
+  root_directory = root_directory.Append(FILE_PATH_LITERAL("extensions"))
+                       .Append(FILE_PATH_LITERAL("ublock"));
+  // Read off the UI thread, like the other component directories.
+  GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&LoadSolContentBlockerManifest, root_directory),
+      base::BindOnce(&ComponentLoader::FinishAddSolContentBlocker,
+                     weak_factory_.GetWeakPtr(), root_directory));
+}
+
+void ComponentLoader::FinishAddSolContentBlocker(
+    const base::FilePath& root_directory,
+    std::optional<base::DictValue> manifest) {
+  if (manifest && !Exists(kSolContentBlockerId)) {
+    Add(std::move(*manifest), root_directory, /*skip_allowlist=*/true);
+  }
+}
+#endif  // BUILDFLAG(IS_WIN)
