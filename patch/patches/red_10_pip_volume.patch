+class VolumeSlider : public views::Slider {
+  METADATA_HEADER(VolumeSlider, views::Slider)
+
+ public:
+  VolumeSlider(views::SliderListener* listener,
+               base::RepeatingCallback<void(float)> on_set_by_user)
+      : views::Slider(listener), on_set_by_user_(std::move(on_set_by_user)) {
+    GetViewAccessibility().AddAction(ax::mojom::Action::kSetValue);
+  }
+
+  // views::View:
+  bool HandleAccessibleAction(const ui::AXActionData& action_data) override {
+    // views::Slider's own handler is private; it steps by 0.1 like this one.
+    double value = GetValue();
+    switch (action_data.action) {
+      case ax::mojom::Action::kSetValue:
+        if (!base::StringToDouble(action_data.value, &value)) {
+          return false;
+        }
+        break;
+      case ax::mojom::Action::kIncrement:
+        value += 0.1;
+        break;
+      case ax::mojom::Action::kDecrement:
+        value -= 0.1;
+        break;
+      default:
+        return views::View::HandleAccessibleAction(action_data);
+    }
+    SetValue(static_cast<float>(std::clamp(value, 0.0, 1.0)));
+    on_set_by_user_.Run(GetValue());
+    return true;
+  }
+
+ private:
+  base::RepeatingCallback<void(float)> on_set_by_user_;
+};
+
+BEGIN_METADATA(VolumeSlider)
+END_METADATA
