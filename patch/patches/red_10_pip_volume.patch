+void VideoPictureInPictureWindowControllerImpl::SetVolume(double volume) {
+  // Red: set the media element's own volume, so the page's `volume`, its
+  // `volumechange` event and the site's own controls follow the slider.
+  if (active_session_) {
+    active_session_->GetMediaPlayerRemote()->RequestSetVolume(
+        std::clamp(volume, 0.0, 1.0));
+  }
+}
+
+std::optional<double> VideoPictureInPictureWindowControllerImpl::GetVolume() {
+  if (!active_session_ || !active_session_->player_id().has_value()) {
+    return std::nullopt;
+  }
+  return static_cast<WebContentsImpl*>(web_contents())
+      ->media_web_contents_observer()
+      ->GetPlayerVolume(active_session_->player_id().value());
+}
+
+void VideoPictureInPictureWindowControllerImpl::MediaVolumeChanged(
+    const MediaPlayerId& id,
+    double volume) {
+  if (!window_ || !active_session_ || active_session_->player_id() != id ||
+      web_contents()->IsBeingDestroyed()) {
+    return;
+  }
+  window_->SetMediaVolume(volume);
+}
